<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded "stop" square inside the D-pad center; follows the parent's pressed state. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="5dp" />
            <solid android:color="@color/color_danger" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="5dp" />
            <solid android:color="@color/dpad_center_dot" />
        </shape>
    </item>
</selector>
