<?xml version="1.0" encoding="utf-8"?>
<!--
    D-pad direction button. Filled brand green while the direction is held so the user can
    see which way the robot is being driven. Supports pressed, activated and selected so code
    can also drive the highlight explicitly (e.g. view.setPressed(true) in a touch listener).
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="60"
    android:exitFadeDuration="140">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/primary_green" />
            <stroke
                android:width="3dp"
                android:color="@color/primary_green_soft" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="oval">
            <solid android:color="@color/primary_green" />
            <stroke
                android:width="3dp"
                android:color="@color/primary_green_soft" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="oval">
            <solid android:color="@color/primary_green" />
            <stroke
                android:width="3dp"
                android:color="@color/primary_green_soft" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="@color/primary_green_light" />
            <stroke
                android:width="1.5dp"
                android:color="@color/primary_green" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/surface_muted" />
            <stroke
                android:width="1dp"
                android:color="@color/outline" />
        </shape>
    </item>
</selector>
