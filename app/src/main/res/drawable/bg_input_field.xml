<?xml version="1.0" encoding="utf-8"?>
<!-- Filled rounded input. Container uses addStatesFromChildren so focus of the EditText shows here. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_input" />
            <solid android:color="@color/surface" />
            <stroke
                android:width="1.5dp"
                android:color="@color/primary_green" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_input" />
            <solid android:color="@color/input_fill" />
            <stroke
                android:width="1dp"
                android:color="@color/outline" />
        </shape>
    </item>
</selector>
