<?xml version="1.0" encoding="utf-8"?>
<!-- Main play / pause control on the robot control screen. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/on_primary_ripple">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/primary_green" />
            <stroke
                android:width="4dp"
                android:color="@color/primary_green_soft" />
        </shape>
    </item>
</ripple>
