<?xml version="1.0" encoding="utf-8"?>
<!-- Center (stop movement) button of the D-pad; turns red-tinted while pressed. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="60"
    android:exitFadeDuration="140">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/danger_soft" />
            <stroke
                android:width="2dp"
                android:color="@color/color_danger" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="@color/surface" />
            <stroke
                android:width="2dp"
                android:color="@color/primary_green" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/surface" />
            <stroke
                android:width="1.5dp"
                android:color="@color/outline_strong" />
        </shape>
    </item>
</selector>
