<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        Night base theme. All screens use a hard-coded light palette (white surfaces, dark text),
        so the night configuration intentionally stays on a light Material3 base. This keeps
        AlertDialogs / BottomSheets light so their dark text remains readable in dark mode.
        Brand colors are applied in Theme.RobotVacuumApp (values/themes.xml) for both modes.
    -->
    <style name="Base.Theme.RobotVacuumApp" parent="Theme.Material3.Light.NoActionBar" />
</resources>
