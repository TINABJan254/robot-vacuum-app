<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:background="@drawable/bg_card_settings_group"
    android:elevation="1dp"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingVertical="16dp">

    <!-- Timezone / Label -->
    <TextView
        android:id="@+id/tv_schedule_timezone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/schedule_default_tz"
        android:textColor="@color/text_hint"
        android:textSize="12sp"
        tools:text="GMT+07:00" />

    <!-- Main Row: Time + Mode + Toggle Switch -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_schedule_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="08:00"
            android:textColor="@color/text_title"
            android:textSize="28sp"
            android:textStyle="bold"
            tools:text="08:00" />

        <TextView
            android:id="@+id/tv_schedule_mode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/schedule_mode_auto"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            tools:text="Dọn dẹp tự động" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_schedule"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:splitTrack="false"
            android:thumb="@drawable/bg_switch_thumb"
            android:track="@drawable/bg_switch_track"
            app:showText="false" />
    </LinearLayout>

    <!-- Repeat Days -->
    <TextView
        android:id="@+id/tv_schedule_repeat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/schedule_days_workdays"
        android:textColor="@color/text_hint"
        android:textSize="13sp"
        tools:text="Ngày làm việc" />

</LinearLayout>
