<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/control_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background">

    <!-- Top App Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/top_bar"
        android:layout_width="0dp"
        android:layout_height="@dimen/top_bar_height"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Back Button -->
        <ImageView
            android:id="@+id/btn_back"
            style="@style/Widget.Robot.TopBarIcon"
            android:layout_width="@dimen/top_bar_icon_size"
            android:layout_height="@dimen/top_bar_icon_size"
            android:contentDescription="@null"
            android:src="@drawable/ic_arrow_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Robot Title -->
        <TextView
            android:id="@+id/tv_robot_title"
            style="@style/Widget.Robot.TopBarTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:gravity="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn_settings"
            app:layout_constraintStart_toEndOf="@id/btn_back"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Robot_01" />

        <!-- Settings Button -->
        <ImageView
            android:id="@+id/btn_settings"
            style="@style/Widget.Robot.TopBarIcon"
            android:layout_width="@dimen/top_bar_icon_size"
            android:layout_height="@dimen/top_bar_icon_size"
            android:contentDescription="@null"
            android:src="@drawable/ic_settings"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Status card: Battery (Left) & live status (Right) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_status_bar"
        style="@style/Widget.Robot.Card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_padding"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="@dimen/screen_padding"
        android:paddingStart="18dp"
        android:paddingTop="16dp"
        android:paddingEnd="18dp"
        android:paddingBottom="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_bar">

        <!-- Battery level -->
        <LinearLayout
            android:id="@+id/layout_battery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_day_circle_unselected">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_battery_charge" />
            </FrameLayout>

            <TextView
                android:id="@+id/tv_battery_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textColor="@color/text_title"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="93 %" />
        </LinearLayout>

        <!-- Status and update feedback with underline -->
        <LinearLayout
            android:id="@+id/layout_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:gravity="end"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/layout_battery"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Decorative caption (not bound in code) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:text="@string/control_status_caption"
                android:textColor="@color/text_hint"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/telemetry_loading"
                android:gravity="end"
                android:maxLines="4"
                android:ellipsize="end"
                android:textColor="@color/primary_green"
                android:textSize="15sp"
                android:textStyle="bold" />

            <View
                android:id="@+id/status_underline"
                android:layout_width="48dp"
                android:layout_height="3dp"
                android:layout_marginTop="6dp"
                android:background="@color/primary_green" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Center D-Pad Joystick -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_dpad"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:background="@drawable/bg_dpad_outer"
        android:elevation="3dp"
        app:layout_constraintBottom_toTopOf="@id/bottom_action_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_status_bar"
        app:layout_constraintVertical_bias="0.45">

        <!-- Up Arrow Button -->
        <ImageView
            android:id="@+id/btn_dpad_up"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_dpad_button"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/command_forward"
            android:padding="16dp"
            android:src="@drawable/ic_arrow_triangle_up"
            app:tint="@color/dpad_icon_tint"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Down Arrow Button -->
        <ImageView
            android:id="@+id/btn_dpad_down"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_dpad_button"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/command_backward"
            android:padding="16dp"
            android:src="@drawable/ic_arrow_triangle_down"
            app:tint="@color/dpad_icon_tint"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Left Arrow Button -->
        <ImageView
            android:id="@+id/btn_dpad_left"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginStart="14dp"
            android:background="@drawable/bg_dpad_button"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/command_left"
            android:padding="16dp"
            android:src="@drawable/ic_arrow_triangle_left"
            app:tint="@color/dpad_icon_tint"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Right Arrow Button -->
        <ImageView
            android:id="@+id/btn_dpad_right"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/bg_dpad_button"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/command_right"
            android:padding="16dp"
            android:src="@drawable/ic_arrow_triangle_right"
            app:tint="@color/dpad_icon_tint"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Center Circle Button (stop movement) -->
        <FrameLayout
            android:id="@+id/btn_dpad_center"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/bg_dpad_center"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/command_stop_movement"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <View
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_dpad_stop_dot"
                android:duplicateParentState="true" />
        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Bottom Action Bar (Auto/Manual - Play/Pause - Sạc) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottom_action_bar"
        style="@style/Widget.Robot.Card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_padding"
        android:layout_marginEnd="@dimen/screen_padding"
        android:layout_marginBottom="24dp"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Auto / Manual Toggle Button -->
        <TextView
            android:id="@+id/btn_toggle_mode"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:minWidth="92dp"
            android:background="@drawable/bg_control_action"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/command_toggle_mode"
            android:gravity="center"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="@string/telemetry_mode_unknown"
            android:textColor="@color/text_title"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Play / Pause / Stop Toggle Button -->
        <ImageView
            android:id="@+id/btn_play_pause"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_play_button_filled"
            android:contentDescription="@null"
            android:padding="18dp"
            android:src="@drawable/ic_play"
            app:tint="@color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Charge Button (Sạc) -->
        <TextView
            android:id="@+id/btn_charge"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:minWidth="92dp"
            android:background="@drawable/bg_control_action"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="@string/command_dock"
            android:contentDescription="@string/command_return_to_dock"
            android:textColor="@color/text_title"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
