<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Header icon (decorative) -->
    <FrameLayout
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/bg_circle_soft_green">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_nav_robot"
            app:tint="@color/primary_green" />
    </FrameLayout>

    <!-- Dialog Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/pair_robot_title"
        android:textColor="@color/text_title"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:lineSpacingExtra="2dp"
        android:text="@string/pair_robot_description"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <!-- 1. Robot ID Input -->
    <LinearLayout
        style="@style/Widget.Robot.InputContainer"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="20dp">

        <ImageView
            style="@style/Widget.Robot.InputIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_nav_robot" />

        <EditText
            android:id="@+id/edt_robot_id"
            style="@style/Widget.Robot.InputText"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:hint="@string/hint_robot_id"
            android:imeOptions="actionNext"
            android:inputType="number"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- 2. Robot Code Input -->
    <LinearLayout
        style="@style/Widget.Robot.InputContainer"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="12dp">

        <ImageView
            style="@style/Widget.Robot.InputIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_lock_outline" />

        <EditText
            android:id="@+id/edt_robot_code"
            style="@style/Widget.Robot.InputText"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:hint="@string/hint_pair_code"
            android:imeOptions="actionDone"
            android:inputType="textVisiblePassword|textNoSuggestions"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_pair_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:accessibilityLiveRegion="polite"
        android:textColor="@color/strength_weak"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- Dialog Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_dialog_cancel"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/bg_control_action"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="@string/action_cancel"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_dialog_add"
            style="@style/Widget.Robot.PrimaryButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="10dp"
            android:minWidth="0dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="@string/action_pair"
            android:textSize="14sp" />
    </LinearLayout>

</LinearLayout>
