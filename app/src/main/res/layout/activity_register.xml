<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scroll_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/auth_padding"
        android:paddingTop="36dp"
        android:paddingEnd="@dimen/auth_padding"
        android:paddingBottom="24dp">

        <!-- Brand mark (decorative) -->
        <FrameLayout
            android:id="@+id/layout_brand_logo"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_circle_soft_green"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_robot_card_circle_green" />
        </FrameLayout>

        <!-- Title: Tạo tài khoản -->
        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/title_create_account"
            android:textColor="@color/text_title"
            android:textSize="26sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layout_brand_logo" />

        <TextView
            android:id="@+id/tv_subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/register_subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_title" />

        <!-- 1. Full Name field -->
        <LinearLayout
            android:id="@+id/layout_full_name"
            style="@style/Widget.Robot.InputContainer"
            android:layout_width="0dp"
            android:layout_height="@dimen/input_height"
            android:layout_marginTop="30dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_subtitle">

            <ImageView
                style="@style/Widget.Robot.InputIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_person_outline" />

            <EditText
                android:id="@+id/edt_full_name"
                style="@style/Widget.Robot.InputText"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:hint="@string/hint_full_name"
                android:imeOptions="actionNext"
                android:inputType="textPersonName|textCapWords" />
        </LinearLayout>

        <!-- 2. Username field -->
        <LinearLayout
            android:id="@+id/layout_username"
            style="@style/Widget.Robot.InputContainer"
            android:layout_width="0dp"
            android:layout_height="@dimen/input_height"
            android:layout_marginTop="14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layout_full_name">

            <ImageView
                style="@style/Widget.Robot.InputIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_badge_outline" />

            <EditText
                android:id="@+id/edt_username"
                style="@style/Widget.Robot.InputText"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:hint="@string/hint_username"
                android:imeOptions="actionNext"
                android:inputType="text" />
        </LinearLayout>

        <!-- 3. Password field + strength meter -->
        <LinearLayout
            android:id="@+id/layout_password"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layout_username">

            <LinearLayout
                style="@style/Widget.Robot.InputContainer"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height">

                <ImageView
                    style="@style/Widget.Robot.InputIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_lock_outline" />

                <EditText
                    android:id="@+id/edt_password"
                    style="@style/Widget.Robot.InputText"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:hint="@string/hint_password"
                    android:imeOptions="actionNext"
                    android:inputType="textPassword" />

                <ImageView
                    android:id="@+id/btn_toggle_password"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@null"
                    android:padding="5dp"
                    android:src="@drawable/ic_eye_outline" />
            </LinearLayout>

            <!-- Password Strength Indicator (4 Bars) -->
            <LinearLayout
                android:id="@+id/layout_strength_bars"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="4dp"
                android:orientation="horizontal">

                <View
                    android:id="@+id/bar_strength_1"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_strength_bar_segment" />

                <View
                    android:id="@+id/bar_strength_2"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_strength_bar_segment" />

                <View
                    android:id="@+id/bar_strength_3"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_strength_bar_segment" />

                <View
                    android:id="@+id/bar_strength_4"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_strength_bar_segment" />
            </LinearLayout>

            <!-- Password Strength Text -->
            <TextView
                android:id="@+id/tv_password_strength"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="6dp"
                android:text="@string/password_strength"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 4. Confirm Password field -->
        <LinearLayout
            android:id="@+id/layout_confirm_password"
            style="@style/Widget.Robot.InputContainer"
            android:layout_width="0dp"
            android:layout_height="@dimen/input_height"
            android:layout_marginTop="14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layout_password">

            <ImageView
                style="@style/Widget.Robot.InputIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_shield_check_outline" />

            <EditText
                android:id="@+id/edt_confirm_password"
                style="@style/Widget.Robot.InputText"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:hint="@string/hint_confirm_password"
                android:imeOptions="actionDone"
                android:inputType="textPassword" />

            <ImageView
                android:id="@+id/btn_toggle_confirm_password"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@null"
                android:padding="5dp"
                android:src="@drawable/ic_eye_outline" />
        </LinearLayout>

        <!-- Register Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_register"
            style="@style/Widget.Robot.PrimaryButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="32dp"
            android:text="@string/btn_register"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layout_confirm_password" />

        <!-- Footer: Đã có tài khoản? Đăng nhập ngay -->
        <TextView
            android:id="@+id/tv_login_prompt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btn_register"
            tools:text="Đã có tài khoản? Đăng nhập ngay" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
